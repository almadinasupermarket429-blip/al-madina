# ---- Database (Postgres) ----
# Use your provider's pooled connection string here (Neon, Supabase, Railway, etc.).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Some providers (e.g. Neon) also give you a *direct*, non-pooled connection string —
# Prisma needs it for migrations. If your provider only gives you one URL, use the
# same value for both.
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ---- Admin login (the /admin portal) ----
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"
# Random long string used to sign admin login sessions. Generate one with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string"

# ---- Outgoing email (order confirmations, notifications) ----
# This project sends email over standard SMTP using Nodemailer.
# Use any SMTP provider: Gmail (with an App Password), Resend, Brevo (Sendinblue), SendGrid, Mailgun, your host's mail server, etc.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="Al-Madina Markt <orders@al-madina-markt.de>"

# Where new-order notification emails go (your client's inbox)
STORE_NOTIFICATION_EMAIL="owner@al-madina-markt.de"

# Public URL of the deployed site (used to build links inside emails)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudinary (product photos). CLOUDINARY_CLOUD_NAME is also used to serve photos through /img — rebuild after changing it.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# "Sign in with Google" (optional). Create an OAuth client in Google Cloud Console.
# Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
